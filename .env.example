APP_NAME="Qaat ERP"
APP_ENV=production
# ⚠️ أنشئ مفتاحاً جديداً بعد أول تثبيت: php artisan key:generate
# لا تُعِد استخدام مفتاح من بيئة أخرى أبداً
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

# إجبار HTTPS في الإنتاج (الفحص F-16) — اتركه false للتطوير المحلي
APP_FORCE_HTTPS=true

# حساب مدير النظام الأول (php artisan db:seed)
ADMIN_EMAIL=admin@erp.local
# ⚠️ غيّر ADMIN_PASSWORD قبل البذر — وغيّرها مجدداً من الشاشة بعد أول دخول
ADMIN_PASSWORD=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qat_dp
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# تحصين الجلسة والكوكيز (الفحص F-16)
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# على الاستضافة المشتركة بدون Supervisor استخدم database مع عامل
# queue:work عبر cron — انظر README (قسم الطوابير)
QUEUE_CONNECTION=database

CACHE_STORE=database
DB_QUEUE_RETRY_AFTER=3900
DB_CACHE_LOCK_TABLE=cache_locks

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# الصلاحيات مفعّلة افتراضياً بعد بناء نظام المصادقة (F-01)
PERMISSIONS_ENABLED=true

BACKUP_MYSQLDUMP_PATH=
BACKUP_MYSQL_PATH=
BACKUP_RETENTION_COUNT=7
BACKUP_LOCK_TIMEOUT=3600
BACKUP_TIMEOUT=600
